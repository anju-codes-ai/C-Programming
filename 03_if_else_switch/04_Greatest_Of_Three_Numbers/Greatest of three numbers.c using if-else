
#include <stdio.h>

int main() {
    int a = 10, b = 25, c = 15;

    if (a > b && a > c) {
        printf("A is Greatest");
    }
    else if (b > a && b > c) {
        printf("B is Greatest");
    }
    else if (c > a && c > b) {
        printf("C is Greatest");
    }
    else {
        printf("Some Numbers are Equal");
    }

    return 0;
}
